# Environment variables for the Enterprise Knowledge Agent backend
#
# Copy this file to .env (which is git-ignored) and fill in your values.
# Never commit .env or any file containing real credentials.
#
#   cp .env.example .env
#
# ── Azure AI Search ──────────────────────────────────────────────────────────
# Found in: Azure Portal → AI Search resource → Settings → Keys
AZURE_SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<your-admin-key>

# ── Azure OpenAI — Embedding resource (Korea Central) ────────────────────────
# Resource: ai103-openai-embedding
# Deployment: text-embedding-3-small (Global Standard, 1536 dimensions)
# Found in: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-openai-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# API version — default works; only change if Azure deprecates it
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Foundry ─────────────────────────────────────────────────────────
# New Foundry Projects API
# Found in: Microsoft Foundry → project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>

# Exact persisted agent name from Microsoft Foundry → Build → Agents
FOUNDRY_AGENT_NAME=enterprise-knowledge-agent

# ── Ingestion script overrides (optional) ────────────────────────────────────
# Override the default docs/pilot-documents path when running ingest_pilot_documents.py
# PILOT_DOCS_DIR=docs/pilot-documents
