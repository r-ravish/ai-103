# Environment variables for the Enterprise Knowledge Agent backend
#
# Copy this file to .env (which is git-ignored) and fill in your values.
# Never commit .env or any file containing real credentials.
#
#   cp .env.example .env
#
# ── Azure AI Search ──────────────────────────────────────────────────────────
# Found in: Azure Portal → AI Search resource → Settings → Keys
AZURE_SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<your-admin-key>

# ── Azure OpenAI — Embedding resource (Korea Central) ────────────────────────
# Resource: ai103-openai-embedding
# Deployment: text-embedding-3-small (Global Standard, 1536 dimensions)
# Found in: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-openai-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# API version — default works; only change if Azure deprecates it
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Foundry ─────────────────────────────────────────────────────────
# New Foundry Projects API
# Found in: Microsoft Foundry → project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>

# Exact persisted agent name from Microsoft Foundry → Build → Agents
FOUNDRY_AGENT_NAME=enterprise-knowledge-agent

# ── Ingestion script overrides (optional) ────────────────────────────────────
# Override the default docs/pilot-documents path when running ingest_pilot_documents.py
# PILOT_DOCS_DIR=docs/pilot-documents

# ── Azure AI Content Safety (Day 3 — content safety wiring) ─────────────────
# Found in: Azure Portal → AI Services → Content Safety resource → Keys and Endpoint
#
# Set AZURE_CONTENT_SAFETY_ENDPOINT to enable live input/output screening.
# If left unset, the backend runs in passthrough mode (no screening) — useful
# for local development without Azure credentials.
#
# Never commit real keys. Store them in .env (git-ignored) or Azure Key Vault.
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_API_KEY=<set-in-environment-or-key-vault-not-in-code>

# API version — 2024-09-01 is the current GA version
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# Severity threshold (integer 0–6):
#   2 = Low (strict)  — recommended for enterprise HR context
#   4 = Medium
#   6 = High (permissive)
AZURE_CONTENT_SAFETY_SEVERITY_THRESHOLD=2

# ── MCP Server Configuration ──────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PUBLIC_HOST=<your-ngrok-host-or-public-domain>

# ── Microsoft Teams / Bot Framework ──────────────────────────────────────────
# Create an Azure Bot (Multi Tenant) to get these credentials.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=
# ── PostgreSQL Database (Day 4+) ──────────────────────────────────────────────
# Async URL used by FastAPI routes (asyncpg driver):
DATABASE_URL=postgresql+asyncpg://ai103:ai103dev@localhost:5432/ai103_enterprise

# Sync URL used only by Alembic and seed scripts (auto-derived if omitted):
# SYNC_DATABASE_URL=postgresql+psycopg2://ai103:ai103dev@localhost:5432/ai103_enterprise

# Set to true to log all generated SQL (useful for debugging, verbose in prod):
# SQLALCHEMY_ECHO=false

# ── Authentication (Part 1 — Auth + RBAC) ────────────────────────────────────
# HMAC secret used to sign session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value — set it in .env (git-ignored) or a secrets manager.
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256

# Session lifetime, in minutes (default: 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set to true in production so the session cookie is only sent over HTTPS.
# Leave false for local http://localhost development.
AUTH_COOKIE_SECURE=false
