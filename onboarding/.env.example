# Environment variables for the Onboarding module
#
# Copy this file to onboarding/.env (which is git-ignored) and fill in your values.
# Never commit .env or any file containing real credentials.
#
#   cp onboarding/.env.example onboarding/.env
#
# Alternatively, you can use the existing backend/.env file — the config module
# reads both, with onboarding/.env taking precedence.
#
# ── Azure AI Search ──────────────────────────────────────────────────────────
# Found in: Azure Portal → AI Search resource → Settings → Keys
# Resource: ai103-enterprise-search-ravish (Central India)
AZURE_SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<your-admin-key>

# The index the onboarding module writes to — must match Ravish's index name exactly
SEARCH_INDEX_NAME=enterprise-knowledge-index

# ── Azure OpenAI — Embedding resource (Korea Central) ────────────────────────
# Resource: ai103-openai-embedding
# Deployment: text-embedding-3-small (Global Standard, 1536 dimensions)
# Found in: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-openai-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Document Intelligence (optional — required for PDF parsing) ─────
# Found in: Azure Portal → Document Intelligence resource → Keys and Endpoint
# If not set, pypdf is used as a fallback for PDF files.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-doc-intel-key>

# ── Chunking / upload tuning (optional — defaults match the ingestion contract) ─
# MAX_TOKENS_PER_CHUNK=500
# OVERLAP_TOKENS=60
# EMBED_BATCH_SIZE=16
# UPLOAD_BATCH_SIZE=100
# MAX_UPLOAD_SIZE_MB=50
