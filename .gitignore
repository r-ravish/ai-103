.env
.env.*
!.env.example

# ── OS / editor artefacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Jupyter / notebooks ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Azure / deployment artefacts ─────────────────────────────────────────────
*.pem
*.pfx

# ── Evaluation run output ─────────────────────────────────────────────────────
